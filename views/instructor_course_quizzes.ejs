<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course Quizzes | LMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans bg-slate-100 min-h-screen">
<nav class="bg-slate-800 p-4 text-white">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <a href="/instructor/instructor_dashboard">LMS</a>
        <div>
            <a href="/instructor/logout" class="bg-red-500 px-3 py-1 rounded">Sign Out</a>
        </div>
    </div>
</nav>

<div class="max-w-6xl mx-auto p-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">All Quizzes for Course</h1>
        <a href="/instructor/view-details/<%= courseId %>" class="bg-slate-700 text-white px-4 py-2 rounded">Back to Course</a>
    </div>

    <% if (quizzes && quizzes.length > 0) { %>
        <div class="space-y-4">
            <% quizzes.forEach(quiz => { %>
                <div class="p-4 bg-white rounded shadow flex justify-between items-center">
                    <div>
                        <h3 class="font-semibold"><%= quiz.title %></h3>
                        <p class="text-sm text-gray-500">Questions: <%= quiz.questions.length %> • Created: <%= quiz.createdAt.toLocaleString() %></p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/instructor/quiz/<%= quiz._id %>" class="px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700">View Quiz</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center py-12">
            <p class="text-gray-600">No quizzes found for this course.</p>
        </div>
    <% } %>
</div>

</body>
</html>
